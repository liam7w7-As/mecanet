NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://root:@localhost:3306/unithor_db

# Generar secretos de al menos 32 bytes (64 caracteres hexadecimales) con: openssl rand -hex 32
JWT_ACCESS_SECRET=your_32_chars_or_more_access_secret_hex_generated_with_openssl
JWT_REFRESH_SECRET=your_32_chars_or_more_refresh_secret_hex_generated_with_openssl
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

COOKIE_DOMAIN=
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
UPLOAD_DIR=./storage/uploads
MAX_INSPECTION_PHOTO_SIZE_MB=8

# Seed Admin User
SEED_ADMIN_EMAIL=your_admin_email@domain.com
SEED_ADMIN_PASSWORD=your_secure_password_min_12_chars
SEED_ADMIN_NAME="Desarrollador UNITHOR"
